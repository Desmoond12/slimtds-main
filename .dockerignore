# Landing/docs live in the slimtds-site submodule mounted at site/ on the demo
# VPS only. Exclude it so prod images (vendor stage COPY . ./) never ship it.
site/

# Docker Desktop was installed with --installation-dir/--wsl-default-data-root
# pointed at this project folder (to keep it off the C: drive). These are the
# app binaries + the WSL VM disk (tens of GB) — never part of the build context.
docker-app/
docker-data/

# node_modules must never enter the build context: bun install runs inside the
# assets-builder stage, so host node_modules is redundant — and worse, it can
# carry broken symlinks (e.g. node_modules/.bin/jiti) that make BuildKit abort
# context load with "invalid file request". vendor/ and .git/ are likewise
# rebuilt/unneeded in-image and only bloat the context.
node_modules/
vendor/
.git/
var/
*.log
