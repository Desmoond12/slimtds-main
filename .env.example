# App
APP_ENV=dev
APP_DEBUG=true
APP_URL=https://slimtds.local
APP_SECRET=CHANGE_ME_32_bytes_random_string
APP_TZ=Europe/Moscow

# Deploy mode (dev|cf_flex|cf_full|direct)
DEPLOY_MODE=dev
DOMAIN=slimtds.local

# Database
DB_HOST=db
DB_PORT=5432
DB_NAME=slimtds
DB_USER=slimtds
DB_PASSWORD=slimtds
DB_DSN=pgsql:host=${DB_HOST};port=${DB_PORT};dbname=${DB_NAME}

# Admin bootstrap (применяется ТОЛЬКО при первом запуске `bin/console admin:init`)
ADMIN_LOGIN=admin
ADMIN_PASSWORD=

# Session
SESSION_NAME=slimtds_sess
SESSION_LIFETIME=1209600           # 14d sliding window, extended on every request
SESSION_ABSOLUTE_LIFETIME=2592000  # 30d hard cap from login, regardless of activity

# FrankenPHP
FRANKENPHP_WORKER_MODE=1
# FRANKENPHP_NUM_THREADS — removed: FrankenPHP defaults to CPU-core count

# Rate-limit (минутные окна)
RATE_LIMIT_IP=10
RATE_LIMIT_LOGIN=5
RATE_LIMIT_COOKIE=20
# Per-IP, per-minute, per-route cap on /postback, /p/event, /p/rec (public,
# unauthenticated endpoints — campaign slugs and the pixel script aren't
# secret). Raise it if a legitimate high-traffic lander trips it.
RATE_LIMIT_PUBLIC=120

# MaxMind (используется в M2)
MAXMIND_ACCOUNT_ID=
MAXMIND_LICENSE_KEY=

# Extra trusted proxies for src/Shared/RealIp.php, on top of Cloudflare's
# built-in ranges (which are always trusted and need no config here).
# Comma-separated CIDR blocks or exact IPs. Only needed in `direct` mode if
# you front slimTDS with your own reverse proxy/load balancer — that proxy's
# IP must be listed here or its X-Forwarded-For/X-Real-IP will be ignored
# and the LB's own IP will be used as the visitor's IP instead.
# Leave empty in `dev`/`cf_flex`/`cf_full` and in `direct` mode with no
# extra proxy in front.
TRUSTED_PROXIES=

# Telegram (используется в M3)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Demo instance (Part 2) — ONLY set these on the dedicated demo VPS, NEVER on prod ---
# DEMO_MODE=1 enables demo:reset (full wipe + reseed every 4h). Absent everywhere else.
DEMO_MODE=
# Public hostname for the demo (used by direct-mode Caddy for Let's Encrypt TLS).
DEMO_DOMAIN=
