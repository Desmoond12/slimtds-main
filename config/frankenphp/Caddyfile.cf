{
    frankenphp {
        worker {
            file /app/config/frankenphp/worker.php
            # Prod: 4 vCPU. Run 8 workers (2x cores) so synchronous request
            # paths (DB roundtrips) don't pin a single core. Without `num`,
            # FrankenPHP runs 1 worker and saturates one CPU only.
            num 8
        }
    }
    servers {
        # Keep in sync with src/Shared/RealIp.php's CLOUDFLARE_RANGES —
        # that's an independent, defense-in-depth check on the same list.
        trusted_proxies static 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
        client_ip_headers CF-Connecting-IP
    }
    auto_https off
    admin off
}

:{$CF_LISTEN_PORT:80} {
    root * /app/public
    encode zstd gzip

    # Baseline security headers on every response (admin UI + engine). Blocks
    # clickjacking of the authenticated admin, MIME-sniffing, and Referer leak.
    # (HSTS is intentionally omitted here — TLS is terminated at Cloudflare in
    # cf mode; enable HSTS on the CF edge. See Caddyfile.direct for the origin-
    # TLS case.)
    header {
        -Server
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }

    # SECURITY: the admin panel must never surface on a public (Cloudflare-
    # proxied) hostname. /admin* and the bare "/" return a hard 404 unless the
    # Host is one of the operator's private entry points:
    #   - 5.252.20.235  direct origin-IP access (plain HTTP — trusted network only)
    #   - localhost     via an SSH tunnel: `ssh -L 8080:localhost:80 root@5.252.20.235`
    #                   then open http://localhost:8080/admin — traffic is
    #                   encrypted end-to-end by SSH (closes the plaintext-HTTP hop).
    # To grant a dedicated admin hostname later (e.g. a CF-proxied admin.<domain>
    # for real HTTPS), add it to the host list below: `not host 5.252.20.235 localhost admin.example`.
    @admin_hidden {
        not host 5.252.20.235 localhost
        path /admin /admin/* /
    }
    handle @admin_hidden {
        respond 404
    }

    @static path /assets/* /p.js /favicon.ico /robots.txt
    handle @static {
        file_server
    }

    @pjs path /p.js
    header @pjs Access-Control-Allow-Origin *

    handle {
        php_server
    }
}
