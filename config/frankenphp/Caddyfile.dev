{
    frankenphp {
        worker {
            file /app/config/frankenphp/worker.php
            watch
            num 8
        }
    }
    auto_https off
    admin off
}

:80 {
    root * /app/public
    encode zstd gzip

    # Baseline security headers (mirrors prod; no HSTS on plain-http dev).
    header {
        -Server
        X-Frame-Options "DENY"
        X-Content-Type-Options "nosniff"
        Referrer-Policy "no-referrer"
    }

    @static path /assets/* /favicon.ico /robots.txt
    handle @static {
        file_server
    }

    @pjs path /p.js
    header @pjs Access-Control-Allow-Origin *

    php_server
}
